# 模型服务配置（复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略，不要提交）
# 本项目使用 Anthropic Messages 兼容接口：POST {LLM_BASE_URL}/v1/messages
LLM_BASE_URL=https://api.example.com
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=sk-your-key-here

# 可选：超时、重试、生成参数
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2500
LLM_TEMPERATURE=0

# 可选：检索参数
RAG_TOPK=4
RAG_CANDIDATES=8
RAG_MIN_COVERAGE_IDF=0.3
RAG_MIN_KEYWORD_OVERLAP=2
RAG_CHUNK_TARGET=520
RAG_CHUNK_MAX=780
RAG_RERANK=1

